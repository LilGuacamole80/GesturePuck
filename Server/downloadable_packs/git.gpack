{
  "id": "git",
  "name": "Git",
  "icon": "🌿",
  "description": "Git workflow gestures — stage, commit, push, pull, and branch inspection.",
  "version": "1.0.0",
  "gestures": {
    "swipe_left": {
      "label": "Soft Reset (undo last commit)",
      "macro": "shell:git reset --soft HEAD~1"
    },
    "swipe_right": {
      "label": "Git Pull",
      "macro": "shell:git pull origin main"
    },
    "swipe_up": {
      "label": "Add, Commit & Push",
      "macro": "shell:git add . && git commit -m \"$(git diff --cached --name-only | tr '\\n' ' ' | sed 's/ $//' | xargs -I{} echo 'update: {}')\" && git push origin main"
    },
    "swipe_down": {
      "label": "Git Status",
      "macro": "shell:git status"
    },
    "push": {
      "label": "New Branch",
      "macro": "shell:git checkout -b gesture/$(date +%Y%m%d-%H%M)"
    },
    "pull": {
      "label": "Git Log (last 5)",
      "macro": "shell:git log --oneline -5"
    },
    "hold_center": {
      "label": "Exit Pack",
      "macro": "__EXIT_PACK__"
    }
  }
}
